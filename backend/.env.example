# Database
DATABASE_URL=postgresql://user:password@localhost:5432/shopify_qa

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars

# Admin credentials (used for initial setup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# AI / External APIs
GROQ_API_KEY=your-groq-api-key-here
FIGMA_DEFAULT_TOKEN=your-figma-personal-access-token-here

# CORS – comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Worker concurrency
MAX_CONCURRENT_RUNS=3

# File storage path for screenshots, PDFs, etc.
STORAGE_PATH=/app/storage
